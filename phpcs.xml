<?xml version="1.0"?>
<ruleset name="ruleset">
	<!-- Errors fail the build; the module carries pre-existing Magento style
	     warnings (missing docblocks, line length) that are advisory only. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<file>Api</file>
	<file>Helper</file>
	<file>Logger</file>
	<file>MessageQueue</file>
	<file>Model</file>
	<file>Observer</file>
	<file>Setup</file>
	<exclude-pattern>Test/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>*/.stale-sync-conflict-backup/*</exclude-pattern>
	<rule ref="Magento2">
		<!-- TODO::check how print_r could be whitelisted -->
		<exclude name="Magento2.Functions.DiscouragedFunction" />
		<exclude name="Magento2.PHP.FinalImplementation" />
	</rule>
</ruleset>